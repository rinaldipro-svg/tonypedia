---
import { CATEGORIES } from '../utils/categories';

const sections = [
  { label: 'Hub', href: '/' },
  { label: 'Feed', href: '/signal/' },
  { label: 'Deep Dives', href: '/studies' },
];
---

<footer class="border-t border-line mt-24">
  <div class="mx-auto max-w-content px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <!-- About -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-teal text-2xl leading-none">●</span>
          <span class="font-display font-black text-xl text-ink tracking-tight">Tonypedia</span>
        </div>
        <p class="text-ink-dim text-sm leading-relaxed max-w-md">
          A curated knowledge hub. Long-form articles, a live GenAI intelligence
          feed, and deep dives into the topics that compound.
        </p>
      </div>

      <!-- Sections -->
      <div class="md:col-span-3">
        <h3 class="label-mono mb-4">Sections</h3>
        <ul class="space-y-2">
          {
            sections.map((s) => (
              <li>
                <a href={s.href} class="text-ink-dim hover:text-ink text-sm transition-colors">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Hub categories -->
      <div class="md:col-span-4">
        <h3 class="label-mono mb-4">Hub categories</h3>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
          {
            Object.entries(CATEGORIES).map(([key, { label, icon }]) => (
              <li>
                <a
                  href={`/category/${key}`}
                  class="text-ink-dim hover:text-ink text-sm transition-colors flex items-center gap-2"
                >
                  <span aria-hidden="true">{icon}</span>
                  <span>{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="border-t border-line mt-12 pt-6 flex flex-col md:flex-row items-center justify-between gap-3 text-ink-faint text-xs">
      <p>© {new Date().getFullYear()} Tonypedia. All rights reserved.</p>
      <p>
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-ink-dim hover:text-ink">Astro</a>
        and deployed on
        <a href="https://pages.cloudflare.com" target="_blank" rel="noopener noreferrer" class="text-ink-dim hover:text-ink">Cloudflare</a>.
      </p>
    </div>
  </div>
</footer>
