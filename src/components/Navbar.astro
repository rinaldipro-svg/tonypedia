---
import { CATEGORIES } from '../utils/categories';

const pathname = new URL(Astro.request.url).pathname;

type SectionKey = 'hub' | 'feed' | 'studies';

function activeSection(path: string): SectionKey {
  if (path.startsWith('/feed') || path.startsWith('/signal')) return 'feed';
  if (path.startsWith('/studies')) return 'studies';
  return 'hub';
}

const active = activeSection(pathname);

const sections: { key: SectionKey; label: string; href: string }[] = [
  { key: 'hub', label: 'Hub', href: '/' },
  { key: 'feed', label: 'Feed', href: '/signal/' },
  { key: 'studies', label: 'Deep Dives', href: '/studies' },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 border-b border-line/0 transition-colors duration-300"
>
  <div class="mx-auto max-w-content px-6 py-4 flex items-center justify-between gap-6">
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-2 font-display font-black text-ink text-xl tracking-tight hover:opacity-90 transition-opacity"
    >
      <span class="text-amber">●</span>
      <span>Tonypedia</span>
    </a>

    <!-- Section switcher (desktop) -->
    <div class="hidden md:flex items-center gap-1 surface-panel px-1 py-1 rounded-full">
      {
        sections.map((s) => {
          const isActive = active === s.key;
          return (
            <a
              href={s.href}
              class:list={[
                'px-4 py-1.5 rounded-full text-sm font-medium transition-colors',
                isActive
                  ? 'bg-ink text-bg'
                  : 'text-ink-dim hover:text-ink',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {s.label}
            </a>
          );
        })
      }
    </div>

    <!-- Right actions -->
    <div class="flex items-center gap-2">
      <button
        id="search-btn"
        class="p-2 rounded-full hairline border text-ink-dim hover:text-ink hover:border-line-2 transition-colors"
        aria-label="Search articles"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-full hairline border text-ink-dim hover:text-ink"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-full left-0 right-0 bg-bg border-b border-line"
  >
    <div class="mx-auto max-w-content px-6 py-6 flex flex-col gap-6">
      <div class="flex flex-col gap-1">
        <span class="label-mono">Sections</span>
        {
          sections.map((s) => (
            <a
              href={s.href}
              class:list={[
                'py-2 text-base',
                active === s.key ? 'text-ink' : 'text-ink-dim hover:text-ink',
              ]}
            >
              {s.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-1 border-t border-line pt-6">
        <span class="label-mono">Hub categories</span>
        {
          Object.entries(CATEGORIES).map(([key, { label, icon }]) => (
            <a
              href={`/category/${key}`}
              class="py-2 text-ink-dim hover:text-ink flex items-center gap-3"
            >
              <span aria-hidden="true">{icon}</span>
              <span>{label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<script>
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const searchBtn = document.getElementById('search-btn');

    mobileMenuBtn?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.contains('hidden') === false;
      if (isOpen) {
        mobileMenu?.classList.add('hidden');
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
      } else {
        mobileMenu?.classList.remove('hidden');
        mobileMenuBtn.setAttribute('aria-expanded', 'true');
      }
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      });
    });

    const onScroll = () => {
      if (!navbar) return;
      if (window.scrollY > 12) {
        navbar.classList.add('bg-bg/85', 'backdrop-blur-md', 'border-line');
        navbar.classList.remove('border-line/0');
      } else {
        navbar.classList.remove('bg-bg/85', 'backdrop-blur-md', 'border-line');
        navbar.classList.add('border-line/0');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    searchBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-search'));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }

  document.addEventListener('astro:after-swap', initNavbar);
</script>
