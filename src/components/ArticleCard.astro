---
import { formatDate, getReadingTime } from '../utils/helpers';
import Chip from './Chip.astro';
import { CATEGORIES, type CategoryKey } from '../utils/categories';

interface Props {
  title: string;
  description: string;
  category: CategoryKey;
  pubDate: Date;
  slug: string;
  heroImage?: string;
  readingTime?: number;
  body?: string;
  tags?: string[];
  size?: 'sm' | 'md' | 'lg';
}

const {
  title,
  description,
  category,
  pubDate,
  slug,
  heroImage,
  readingTime,
  body = '',
  tags = [],
  size = 'md',
} = Astro.props;

const estimatedReadingTime = readingTime || getReadingTime(body);
const meta = CATEGORIES[category];
const accentVar = `var(--cat-${category})`;

const titleCx =
  size === 'lg'
    ? 'text-2xl md:text-3xl'
    : size === 'sm'
      ? 'text-base'
      : 'text-xl';

const imgCx =
  size === 'lg' ? 'h-64' : size === 'sm' ? 'h-32' : 'h-44';
---

<a
  href={`/articles/${slug}`}
  class="card group block overflow-hidden"
  style={`--card-accent:${accentVar};`}
>
  {
    heroImage && (
      <div class={`relative overflow-hidden border-b border-line ${imgCx}`}>
        <img
          src={heroImage}
          alt={title}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-panel/90 via-panel/10 to-transparent pointer-events-none"></div>
      </div>
    )
  }
  <div class="relative p-5 flex flex-col gap-3">
    <div class="flex items-center gap-2 flex-wrap">
      <Chip category={category} variant="category" size="sm" />
      <span class="label-mono text-ink-faint">
        {meta.label === 'Tech & Business' ? 'Tech' : meta.label}
      </span>
    </div>

    <h3
      class={`font-display font-black text-ink leading-tight transition-colors group-hover:text-amber-soft ${titleCx}`}
    >
      {title}
    </h3>

    {size !== 'sm' && (
      <p class="text-sm text-ink-dim leading-relaxed line-clamp-3">
        {description}
      </p>
    )}

    <div class="mt-1 flex items-center justify-between text-[0.7rem] text-ink-faint font-mono uppercase tracking-[0.08em]">
      <span>{formatDate(pubDate)}</span>
      <span>{estimatedReadingTime} min</span>
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-3 border-t border-line">
        {tags.slice(0, 3).map((tag) => (
          <Chip
            label={`#${tag}`}
            href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
            size="sm"
          />
        ))}
      </div>
    )}
  </div>
</a>
