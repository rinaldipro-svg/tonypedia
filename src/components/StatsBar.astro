---
import { formatDate, getReadingTime } from '../utils/helpers';
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;

const totalArticles = articles.length;
const uniqueCategories = new Set(articles.map((a) => a.data.category)).size;
const latestDate =
  articles.length > 0
    ? articles.reduce(
        (latest, article) =>
          article.data.pubDate > latest.data.pubDate ? article : latest,
        articles[0]
      ).data.pubDate
    : new Date();
const totalReadingMinutes = articles.reduce((sum, article) => {
  const minutes = article.data.readingTime || getReadingTime(article.body || '');
  return sum + minutes;
}, 0);

const stats = [
  { value: String(totalArticles), label: 'Articles' },
  { value: String(uniqueCategories), label: 'Categories' },
  { value: formatDate(latestDate), label: 'Last update' },
  { value: `${totalReadingMinutes} min`, label: 'Total read' },
];
---

<section class="mx-auto max-w-content px-6 mt-12">
  <div class="surface-panel grid grid-cols-2 md:grid-cols-4 divide-x divide-line border-line reveal-stagger">
    {
      stats.map((s) => (
        <div class="p-6 md:p-8 flex flex-col gap-1">
          <span class="label-mono">{s.label}</span>
          <span class="font-display text-2xl md:text-3xl text-ink leading-tight">
            {s.value}
          </span>
        </div>
      ))
    }
  </div>
</section>
