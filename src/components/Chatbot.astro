---
import SearchModal from './SearchModal.astro';
---

<SearchModal />

<div id="chatbot-container" class="fixed bottom-6 right-6 z-40">
  <!-- Floating button -->
  <button
    id="chatbot-toggle"
    class="w-14 h-14 rounded-full bg-amber text-bg flex items-center justify-center shadow-xl hover:-translate-y-0.5 transition-transform"
    aria-label="Open assistant"
    aria-expanded="false"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-3.5-7.1L21 3v6h-6"></path>
      <circle cx="9" cy="13" r="1" fill="currentColor"></circle>
      <circle cx="13" cy="13" r="1" fill="currentColor"></circle>
      <circle cx="17" cy="13" r="1" fill="currentColor"></circle>
    </svg>
  </button>

  <!-- Chat panel -->
  <div
    id="chatbot-panel"
    class="hidden fixed bottom-24 right-6 w-[22rem] md:w-96 max-h-[80vh] surface-panel rounded-card flex-col overflow-hidden shadow-2xl"
  >
    <!-- Header -->
    <div class="px-5 py-4 border-b border-line flex items-center justify-between bg-panel-2">
      <div class="flex items-center gap-2">
        <span class="text-amber" aria-hidden="true">●</span>
        <h3 class="font-display text-ink text-sm">Tonypedia AI</h3>
      </div>
      <button
        id="chatbot-close"
        class="text-ink-dim hover:text-ink transition-colors"
        aria-label="Close assistant"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
            clip-rule="evenodd"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Messages -->
    <div id="chatbot-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-3 min-h-[14rem]">
      <div class="text-sm text-ink-dim bg-bg2 border border-line rounded-xl p-3 leading-relaxed">
        Hi — I'm the Tonypedia assistant. Ask me anything about our articles and
        I'll cite the ones I pull from.
      </div>
    </div>

    <!-- Input -->
    <div class="border-t border-line px-3 py-3 bg-panel-2">
      <form id="chatbot-form" class="flex gap-2">
        <input
          id="chatbot-input"
          type="text"
          placeholder="Ask something…"
          class="flex-1 px-3 py-2 rounded-full bg-bg border border-line text-ink placeholder:text-ink-faint focus:outline-none focus:border-amber transition-colors text-sm"
        />
        <button
          type="submit"
          class="px-4 py-2 rounded-full bg-amber text-bg font-medium text-sm hover:-translate-y-0.5 transition-transform"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  interface Message {
    role: 'user' | 'assistant';
    content: string;
    sources?: Array<{ title: string; url: string }>;
  }

  let messages: Message[] = [];
  let isLoading = false;

  function escapeHtml(str: string): string {
    return str.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!)
    );
  }

  function initChatbot() {
    const toggle = document.getElementById('chatbot-toggle');
    const panel = document.getElementById('chatbot-panel');
    const closeBtn = document.getElementById('chatbot-close');
    const form = document.getElementById('chatbot-form');
    const input = document.getElementById('chatbot-input') as HTMLInputElement;
    const messagesBox = document.getElementById('chatbot-messages');

    const setOpen = (open: boolean) => {
      if (!panel) return;
      panel.classList.toggle('hidden', !open);
      panel.classList.toggle('flex', open);
      toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) input?.focus();
    };

    toggle?.addEventListener('click', () => {
      const isOpen = panel?.classList.contains('hidden') === false;
      setOpen(!isOpen);
    });

    closeBtn?.addEventListener('click', () => setOpen(false));

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const message = input?.value.trim();
      if (!message || isLoading) return;

      messages.push({ role: 'user', content: message });
      if (messagesBox) {
        messagesBox.insertAdjacentHTML(
          'beforeend',
          `
          <div class="text-sm bg-amber/15 border border-amber/40 text-ink rounded-xl p-3 ml-10 leading-relaxed">
            ${escapeHtml(message)}
          </div>
        `
        );
        messagesBox.scrollTop = messagesBox.scrollHeight;
      }

      if (input) input.value = '';

      isLoading = true;
      if (messagesBox) {
        messagesBox.insertAdjacentHTML(
          'beforeend',
          `
          <div id="chatbot-typing" class="text-sm bg-bg2 border border-line text-ink-dim rounded-xl p-3">
            <div class="flex gap-1">
              <div class="w-1.5 h-1.5 rounded-full bg-ink-dim animate-bounce" style="animation-delay: 0ms"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-ink-dim animate-bounce" style="animation-delay: 150ms"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-ink-dim animate-bounce" style="animation-delay: 300ms"></div>
            </div>
          </div>
        `
        );
        messagesBox.scrollTop = messagesBox.scrollHeight;
      }

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message,
            history: messages.slice(-5),
          }),
        });

        if (!response.ok) throw new Error('API request failed');

        const data = await response.json();
        const assistantMessage: Message = {
          role: 'assistant',
          content: data.response,
          sources: data.sources,
        };
        messages.push(assistantMessage);

        document.getElementById('chatbot-typing')?.remove();

        if (messagesBox) {
          let html = `
            <div class="text-sm bg-bg2 border border-line text-ink rounded-xl p-3 leading-relaxed">
              ${escapeHtml(data.response)}
          `;

          if (data.sources && data.sources.length > 0) {
            html += '<div class="mt-3 pt-3 border-t border-line space-y-1.5">';
            data.sources.forEach((source: { title: string; url: string }) => {
              html += `
                <a href="${source.url}" target="_blank" rel="noopener noreferrer" class="text-amber-soft hover:text-amber text-xs block">
                  → ${escapeHtml(source.title)}
                </a>
              `;
            });
            html += '</div>';
          }

          html += '</div>';
          messagesBox.insertAdjacentHTML('beforeend', html);
          messagesBox.scrollTop = messagesBox.scrollHeight;
        }
      } catch (error) {
        console.error('Chat error:', error);
        document.getElementById('chatbot-typing')?.remove();
        if (messagesBox) {
          messagesBox.insertAdjacentHTML(
            'beforeend',
            `
            <div class="text-sm bg-rose/15 border border-rose/40 text-ink rounded-xl p-3">
              Sorry — something went wrong. Try again.
            </div>
          `
          );
          messagesBox.scrollTop = messagesBox.scrollHeight;
        }
      } finally {
        isLoading = false;
        input?.focus();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChatbot);
  } else {
    initChatbot();
  }

  document.addEventListener('astro:after-swap', initChatbot);
</script>
