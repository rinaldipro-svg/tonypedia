---
import Chip from './Chip.astro';
import type { CategoryKey } from '../utils/categories';
import { CATEGORIES } from '../utils/categories';

interface Props {
  category?: CategoryKey;
  text?: string;
  href?: string;
  size?: 'sm' | 'md';
  className?: string;
}

const { category, text, href, size = 'md', className = '' } = Astro.props;

if (!category && !text) {
  throw new Error('TagBadge requires either category or text prop');
}

const label = text ?? (category ? CATEGORIES[category].label : '');
---

<Chip
  category={category}
  label={label}
  href={href}
  size={size}
  variant={category ? 'category' : 'neutral'}
  className={className}
/>
