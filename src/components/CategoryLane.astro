---
import ArticleCard from './ArticleCard.astro';
import SectionHeader from './SectionHeader.astro';
import type { CollectionEntry } from 'astro:content';
import type { CategoryKey } from '../utils/categories';
import { CATEGORIES, CATEGORY_KEYS } from '../utils/categories';

interface Props {
  category: CategoryKey;
  articles: CollectionEntry<'articles'>[];
}

const { category, articles } = Astro.props;

const categoryData = CATEGORIES[category];
const categoryArticles = articles
  .filter((a) => a.data.category === category)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const accent = `var(--cat-${category})`;
const index = CATEGORY_KEYS.indexOf(category) + 1;
const number = String(index).padStart(2, '0');
---

<section class="reveal">
  <SectionHeader
    number={number}
    eyebrow={categoryData.label}
    title={categoryData.label}
    italicTail={`— what's happening.`}
    href={`/category/${category}`}
    hrefLabel="View all"
    accent={accent}
  />

  <div class="mx-auto max-w-content px-6">
    {
      categoryArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal-stagger">
          {categoryArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              pubDate={article.data.pubDate}
              slug={article.slug}
              heroImage={article.data.heroImage}
              readingTime={article.data.readingTime}
              body={article.body}
              tags={article.data.tags}
            />
          ))}
        </div>
      ) : (
        <div
          class="surface-panel p-12 text-center"
          style={`background:linear-gradient(180deg, color-mix(in oklab, ${accent} 8%, var(--panel)) 0%, var(--panel) 100%);`}
        >
          <div class="text-4xl mb-3" aria-hidden="true">{categoryData.icon}</div>
          <h3 class="font-display text-xl text-ink mb-2">More on the way</h3>
          <p class="text-ink-dim text-sm">
            {categoryData.label} pieces are in the pipeline.
          </p>
        </div>
      )
    }
  </div>
</section>
