---
---

<section id="newsletter" class="mx-auto max-w-content px-6 mt-24 mb-16">
  <div class="surface-panel relative overflow-hidden p-10 md:p-14">
    <div
      class="absolute -top-32 -right-24 w-96 h-96 rounded-full opacity-30 blur-3xl pointer-events-none"
      style="background:radial-gradient(circle, var(--amber) 0%, transparent 60%);"
    ></div>

    <div class="relative grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <span class="label-mono">Newsletter</span>
        <h2 class="display text-3xl md:text-4xl text-ink mt-3 mb-3 text-balance">
          The signal — <span class="italic-accent text-ink-dim">not the noise.</span>
        </h2>
        <p class="text-ink-dim text-sm leading-relaxed max-w-md">
          New Tonypedia pieces, deep dives, and Intelligence Feed highlights,
          delivered when there's something worth reading.
        </p>
      </div>

      <form id="newsletter-form" class="md:col-span-5 flex flex-col gap-3">
        <input
          type="email"
          name="email"
          placeholder="you@domain.com"
          required
          class="w-full px-4 py-3 rounded-full bg-bg2 border border-line text-ink placeholder:text-ink-faint focus:outline-none focus:border-amber transition-colors"
        />
        <button
          type="submit"
          class="w-full px-4 py-3 rounded-full bg-amber text-bg font-medium hover:-translate-y-0.5 transition-transform"
        >
          Subscribe
        </button>
        <p id="newsletter-message" class="text-center text-xs text-ink-dim hidden"></p>
      </form>
    </div>
  </div>
</section>

<script>
  function initNewsletter() {
    const form = document.getElementById('newsletter-form');
    const message = document.getElementById('newsletter-message');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value;
      if (!email) return;

      try {
        if (message) {
          message.classList.remove('hidden');
          message.textContent = '✓ Thanks for subscribing.';
          (form.querySelector('input[name="email"]') as HTMLInputElement).value = '';
          setTimeout(() => message?.classList.add('hidden'), 5000);
        }
      } catch (error) {
        console.error('Newsletter subscription error:', error);
        if (message) {
          message.classList.remove('hidden');
          message.textContent = 'Something went wrong. Try again.';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNewsletter);
  } else {
    initNewsletter();
  }

  document.addEventListener('astro:after-swap', initNewsletter);
</script>
