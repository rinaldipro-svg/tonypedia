---
/**
 * Light/dark toggle for article pages (see docs/DECISIONS.md D24).
 * The [data-theme] attribute is set pre-paint by BaseLayout's inline
 * <head> snippet; this only handles the user flip + keeps aria / the
 * theme-color meta in sync. localStorage key: "theme" ("light" | "dark").
 * Fixed bottom-left — the chatbot FAB owns bottom-right.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-pressed="false"
  aria-label="Switch to light theme"
>
  <svg class="theme-toggle-icon" viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M8 1.75A6.25 6.25 0 0 1 8 14.25Z" fill="currentColor" />
  </svg>
  <span class="theme-toggle-label">Light</span>
</button>

<style>
  .theme-toggle {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    background: var(--panel);
    border: 1px solid var(--line2);
    box-shadow: var(--shadow);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .theme-toggle-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const root = document.documentElement;
    const meta = document.querySelector('meta[name="theme-color"]');
    const DARK = '#071A1F';
    const LIGHT = '#F2F7F7';

    const sync = () => {
      const light = root.dataset.theme === 'light';
      btn.setAttribute('aria-pressed', String(light));
      btn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      const label = btn.querySelector('.theme-toggle-label');
      if (label) label.textContent = light ? 'Dark' : 'Light';
      if (meta) meta.setAttribute('content', light ? LIGHT : DARK);
    };

    btn.addEventListener('click', () => {
      const light = root.dataset.theme === 'light';
      if (light) {
        delete root.dataset.theme;
        try { localStorage.setItem('theme', 'dark'); } catch (e) {}
      } else {
        root.dataset.theme = 'light';
        try { localStorage.setItem('theme', 'light'); } catch (e) {}
      }
      sync();
    });

    sync();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
</script>
