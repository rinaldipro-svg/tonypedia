---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Intelligence Feed"
  description="A self-compounding AI knowledge base — tools, concepts, playbooks, prompts, market moves and benchmarks."
>
  <iframe
    src="/signal/index.html"
    title="Intelligence Feed"
    loading="eager"
    class="feed-iframe"
  ></iframe>
</BaseLayout>

<style>
  /* BaseLayout reserves pt-24 (6rem) for the sticky topbar; the iframe fills
     the rest of the viewport exactly. */
  .feed-iframe {
    display: block;
    width: 100%;
    height: calc(100vh - 6rem);
    border: none;
    margin: 0;
    padding: 0;
  }
</style>
