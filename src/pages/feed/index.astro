---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const CATEGORY_META = {
  concepts: { label: 'Foundations', accent: 'var(--sky)' },
  tools: { label: 'Tools & Stack', accent: 'var(--amber)' },
  guides: { label: 'Playbooks', accent: 'var(--acid)' },
  prompts: { label: 'Prompts', accent: 'var(--violet)' },
  industry: { label: 'Market Moves', accent: 'var(--rose)' },
  data: { label: 'Benchmarks', accent: 'var(--green)' },
} as const;

type CategoryId = keyof typeof CATEGORY_META;

const entries = (await getCollection('feed')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const feedData = entries.map((e) => ({
  title: e.data.title,
  source: e.data.source,
  category: e.data.category,
  accent: e.data.accent,
  blurb: e.data.blurb,
  tags: e.data.tags,
}));

const tickerTitles = entries.map((e) => e.data.title);
---

<BaseLayout
  title="Intelligence Feed — Tonypedia"
  description="A live, curated stream of GenAI and LLM developments: foundations, tools, playbooks, prompts, market moves, and benchmarks."
>
  <h1 class="sr-only">Intelligence Feed</h1>

  <!-- Ticker -->
  <div class="feed-ticker" aria-hidden="true">
    <div class="feed-ticker-track">
      <span class="feed-ticker-run">
        {tickerTitles.map((t, i) => (
          <>{t}{i < tickerTitles.length - 1 ? ' · ' : ''}</>
        ))}
      </span>
      <span class="feed-ticker-run" aria-hidden="true">
        {tickerTitles.map((t, i) => (
          <>{t}{i < tickerTitles.length - 1 ? ' · ' : ''}</>
        ))}
      </span>
    </div>
  </div>

  <!-- Filter chips -->
  <nav class="feed-filters" aria-label="Filter feed by category">
    <button
      type="button"
      class="feed-chip active"
      data-filter="all"
      style="--chip-accent: var(--ink);"
    >
      All
    </button>
    {(Object.entries(CATEGORY_META) as [CategoryId, typeof CATEGORY_META[CategoryId]][]).map(
      ([key, meta]) => (
        <button
          type="button"
          class="feed-chip"
          data-filter={key}
          style={`--chip-accent: ${meta.accent};`}
        >
          {meta.label}
        </button>
      )
    )}
  </nav>

  <!-- Card grid -->
  <section class="feed-grid" id="feed-grid">
    {entries.map((entry, i) => {
      const meta = CATEGORY_META[entry.data.category];
      return (
        <article
          class:list={['feed-card', entry.data.size]}
          data-index={i}
          data-category={entry.data.category}
          style={`--card-accent: ${entry.data.accent};`}
          tabindex="0"
          role="button"
          aria-label={`Open: ${entry.data.title}`}
        >
          <div class="feed-card-meta">
            <span class="feed-card-cat" style={`color: ${entry.data.accent};`}>
              {meta.label}
            </span>
            <span class="feed-card-source">{entry.data.source}</span>
          </div>
          <h3 class="feed-card-title">{entry.data.title}</h3>
          <p class="feed-card-blurb">{entry.data.blurb}</p>
        </article>
      );
    })}
  </section>

  <!-- Modal -->
  <div
    id="feed-modal"
    class="feed-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="feed-modal-title"
  >
    <div class="feed-modal-overlay" data-close></div>
    <div class="feed-modal-panel" role="document">
      <button
        type="button"
        class="feed-modal-close"
        data-close
        aria-label="Close"
      >×</button>
      <span id="feed-modal-category" class="feed-modal-category"></span>
      <h2 id="feed-modal-title" class="feed-modal-title"></h2>
      <p id="feed-modal-source" class="feed-modal-source"></p>
      <div id="feed-modal-body" class="feed-modal-body"></div>
      <div id="feed-modal-tags" class="feed-modal-tags"></div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ FEED_DATA: feedData, CATEGORY_META }}>
  function initFeed() {
    const grid = document.getElementById('feed-grid');
    const modal = document.getElementById('feed-modal');
    if (!grid || !modal) return;

    const chips = document.querySelectorAll('.feed-chip');
    const cards = document.querySelectorAll('.feed-card');

    // ---- Filter ----
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.getAttribute('data-filter');
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        cards.forEach((card) => {
          const match = filter === 'all' || card.getAttribute('data-category') === filter;
          card.style.display = match ? '' : 'none';
        });
      });
    });

    // ---- Modal ----
    const catEl = document.getElementById('feed-modal-category');
    const titleEl = document.getElementById('feed-modal-title');
    const sourceEl = document.getElementById('feed-modal-source');
    const bodyEl = document.getElementById('feed-modal-body');
    const tagsEl = document.getElementById('feed-modal-tags');
    let lastFocused = null;

    function openModal(idx) {
      const entry = FEED_DATA[idx];
      if (!entry) return;
      const meta = CATEGORY_META[entry.category];

      catEl.textContent = meta.label;
      catEl.style.color = entry.accent;
      titleEl.textContent = entry.title;
      sourceEl.textContent = entry.source;
      bodyEl.textContent = entry.blurb;

      tagsEl.innerHTML = '';
      entry.tags.forEach((tag) => {
        const span = document.createElement('span');
        span.className = 'chip';
        span.textContent = '#' + tag;
        tagsEl.appendChild(span);
      });

      lastFocused = document.activeElement;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.querySelector('.feed-modal-close').focus();
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }

    function handleCardActivate(target) {
      const card = target.closest && target.closest('.feed-card');
      if (!card) return;
      const idx = Number(card.getAttribute('data-index'));
      openModal(idx);
    }

    grid.addEventListener('click', (e) => handleCardActivate(e.target));
    grid.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        if (e.target.classList && e.target.classList.contains('feed-card')) {
          e.preventDefault();
          handleCardActivate(e.target);
        }
      }
    });

    modal.querySelectorAll('[data-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeed);
  } else {
    initFeed();
  }
  document.addEventListener('astro:after-swap', initFeed);
</script>

<style is:global>
  /* Accessibility helper */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- Ticker ---- */
  .feed-ticker {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 10px 0;
    background: var(--bg2);
  }
  .feed-ticker-track {
    display: flex;
    width: max-content;
    animation: feed-ticker-scroll 90s linear infinite;
    will-change: transform;
  }
  .feed-ticker-run {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: var(--ink-faint);
    white-space: nowrap;
    padding-right: 3rem;
    letter-spacing: 0.05em;
  }
  @keyframes feed-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .feed-ticker-track {
      animation: none;
    }
  }

  /* ---- Filter chips ---- */
  .feed-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 24px;
    max-width: 72rem;
    margin: 0 auto;
  }
  .feed-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease;
  }
  .feed-chip:hover {
    color: var(--ink);
    border-color: var(--line-2);
  }
  .feed-chip:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 2px;
  }
  .feed-chip.active {
    background: var(--chip-accent);
    color: var(--bg);
    border-color: var(--chip-accent);
  }

  /* ---- Grid ---- */
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
    padding: 0 24px 64px;
    max-width: 72rem;
    margin: 0 auto;
  }
  .feed-card { grid-column: span 12; }
  @media (min-width: 768px) {
    .feed-card.col4 { grid-column: span 4; }
    .feed-card.col6 { grid-column: span 6; }
    .feed-card.col8 { grid-column: span 8; }
  }

  /* ---- Card ---- */
  .feed-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
    cursor: pointer;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }
  .feed-card:hover,
  .feed-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px color-mix(in oklab, var(--card-accent) 15%, transparent);
    border-color: var(--line-2);
  }
  .feed-card:focus-visible {
    outline: 2px solid var(--card-accent);
    outline-offset: 2px;
  }
  .feed-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .feed-card-cat {
    font-weight: 500;
  }
  .feed-card-source {
    color: var(--ink-faint);
    text-align: right;
    font-style: normal;
  }
  .feed-card-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
    margin: 0 0 10px;
  }
  .feed-card-blurb {
    font-family: var(--font-ui);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-dim);
    margin: 0;
  }

  /* ---- Modal ---- */
  .feed-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
  }
  .feed-modal.open { display: block; }
  .feed-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .feed-modal-panel {
    position: relative;
    width: calc(100% - 32px);
    max-width: 680px;
    max-height: 80vh;
    overflow-y: auto;
    margin: 8vh auto 0;
    background: var(--panel2);
    border: 1px solid var(--line-2);
    border-radius: 20px;
    padding: 36px;
    color: var(--ink);
  }
  .feed-modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    font-size: 22px;
    line-height: 1;
    padding: 8px 12px;
    background: transparent;
    border: none;
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 180ms ease;
  }
  .feed-modal-close:hover { color: var(--ink); }
  .feed-modal-close:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 2px;
    border-radius: 6px;
  }
  .feed-modal-category {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .feed-modal-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 26px;
    color: var(--ink);
    line-height: 1.15;
    margin: 10px 0 8px;
    letter-spacing: -0.01em;
  }
  .feed-modal-source {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    margin: 0 0 20px;
    letter-spacing: 0.05em;
  }
  .feed-modal-body {
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }
  .feed-modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .feed-modal-tags:empty { display: none; }
  .feed-modal-tags:not(:empty) {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
</style>
