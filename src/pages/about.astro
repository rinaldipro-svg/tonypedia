---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_KEYS } from '../utils/categories';
---

<BaseLayout title="About Tonypedia" description="Tonypedia is a curated knowledge hub.">
  <header class="mx-auto max-w-content px-6 pt-12 md:pt-16 pb-10">
    <div class="flex items-center gap-3 mb-4">
      <span class="label-mono">About</span>
      <span class="h-px w-12 block bg-line" aria-hidden="true"></span>
    </div>
    <h1 class="display text-5xl md:text-7xl text-ink text-balance">
      A knowledge hub <span class="italic-accent text-ink-dim">— not a feed.</span>
    </h1>
  </header>

  <section class="mx-auto max-w-prose px-6 pb-20">
    <div class="prose prose-lg max-w-none">
      <p>
        Tonypedia is a curated knowledge hub. In an age of information overload, we
        believe deep, nuanced understanding matters more than ever — and that what
        you choose <em>not</em> to read matters as much as what you do.
      </p>

      <h2>What we cover</h2>
    </div>

    <ul class="not-prose grid grid-cols-1 md:grid-cols-2 gap-3 mt-6">
      {
        CATEGORY_KEYS.map((key) => {
          const meta = CATEGORIES[key];
          const accent = `var(--cat-${key})`;
          return (
            <li
              class="surface-panel p-4 flex items-start gap-3"
              style={`background:linear-gradient(180deg, color-mix(in oklab, ${accent} 8%, var(--panel)) 0%, var(--panel) 100%);`}
            >
              <span class="text-xl leading-none" aria-hidden="true">{meta.icon}</span>
              <div>
                <span class="label-mono" style={`color:${accent};`}>{meta.label}</span>
                <p class="text-ink-dim text-sm mt-1">
                  Explore <a href={`/category/${key}`} class="text-ink hover:text-amber-soft">/category/{key}</a>.
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>

    <div class="prose prose-lg max-w-none mt-12">
      <h2>How it works</h2>
      <p>
        Three sections, one taxonomy. The <strong>Hub</strong> is long-form curated
        writing. The <strong>Feed</strong> is a living record of GenAI and LLM
        developments. <strong>Deep Dives</strong> are study-length pages
        on the topics that compound. Tags cut across them so a single thread can
        be followed everywhere it touches.
      </p>
      <p>
        An assistant lives in the bottom-right corner. Ask it anything about the
        material — it cites the articles it pulls from.
      </p>

      <h2>Built with</h2>
      <p>
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>,
        Tailwind, and
        <a href="https://pages.cloudflare.com" target="_blank" rel="noopener noreferrer">Cloudflare Pages</a>.
        The assistant runs on
        <a href="https://www.anthropic.com" target="_blank" rel="noopener noreferrer">Claude</a>
        via a Worker.
      </p>
    </div>

    <div class="surface-panel mt-12 p-6">
      <span class="label-mono">Get in touch</span>
      <p class="text-ink-dim text-sm mt-2">
        Questions or feedback? The footer has the links, or just talk to the
        assistant — it can route messages.
      </p>
    </div>
  </section>
</BaseLayout>
