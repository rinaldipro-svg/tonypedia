---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_KEYS } from '../utils/categories';
---

<BaseLayout title="404 — Not found | Tonypedia">
  <div class="mx-auto max-w-prose px-6 pt-16 md:pt-32 pb-24 text-center">
    <div class="display text-[6rem] md:text-[10rem] leading-none text-ink-faint mb-4">
      4<span class="italic-accent text-teal">0</span>4
    </div>

    <h1 class="display text-3xl md:text-4xl text-ink mb-3">Page not found</h1>
    <p class="text-ink-dim mb-10 max-w-md mx-auto">
      The page you're looking for doesn't exist. It may have moved, or never
      existed.
    </p>

    <div class="flex justify-center mb-10">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-amber text-bg font-medium hover:-translate-y-0.5 transition-transform"
      >
        <span>← Back to the Hub</span>
      </a>
    </div>

    <div class="border-t border-line pt-8">
      <span class="label-mono">Or explore</span>
      <div class="flex flex-wrap justify-center gap-2 mt-4">
        {
          CATEGORY_KEYS.map((key) => {
            const meta = CATEGORIES[key];
            const accent = `var(--cat-${key})`;
            return (
              <a
                href={`/category/${key}`}
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line text-ink-dim hover:text-ink hover:border-line-2 text-sm transition-colors"
                style={`--card-accent:${accent};`}
              >
                <span aria-hidden="true">{meta.icon}</span>
                <span>{meta.label}</span>
              </a>
            );
          })
        }
        <a
          href="/articles"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line text-ink-dim hover:text-ink hover:border-line-2 text-sm transition-colors"
        >
          All articles
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
