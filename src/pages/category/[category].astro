---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CategorySubnav from '../../components/CategorySubnav.astro';
import { CATEGORIES, CATEGORY_KEYS, type CategoryKey } from '../../utils/categories';

export async function getStaticPaths() {
  return CATEGORY_KEYS.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params as { category: CategoryKey };
const categoryData = CATEGORIES[category];

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const categoryArticles = allArticles
  .filter((a) => a.data.category === category)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const accent = `var(--cat-${category})`;
const number = String(CATEGORY_KEYS.indexOf(category) + 1).padStart(2, '0');
---

<BaseLayout
  title={`${categoryData.label} | Tonypedia`}
  description={`Explore all articles in the ${categoryData.label} category on Tonypedia.`}
>
  <CategorySubnav active={category} />

  <header class="mx-auto max-w-content px-6 pt-12 md:pt-16 pb-10">
    <div class="flex items-center gap-3 mb-4">
      <span class="label-mono" style={`color:${accent};`}>
        {number} · Hub category
      </span>
      <span class="h-px w-12 block bg-line" aria-hidden="true"></span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <div class="md:col-span-8">
        <h1 class="display text-5xl md:text-6xl text-ink text-balance">
          <span aria-hidden="true" class="mr-3">{categoryData.icon}</span>
          {categoryData.label}
        </h1>
      </div>
      <p class="md:col-span-4 md:text-right text-ink-dim text-sm">
        {categoryArticles.length} article{categoryArticles.length !== 1 ? 's' : ''} ·
        sorted by publish date
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-content px-6 pb-16">
    {
      categoryArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
          {categoryArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              pubDate={article.data.pubDate}
              slug={article.slug}
              heroImage={article.data.heroImage}
              readingTime={article.data.readingTime}
              body={article.body}
              tags={article.data.tags}
            />
          ))}
        </div>
      ) : (
        <div
          class="surface-panel p-12 text-center"
          style={`background:linear-gradient(180deg, color-mix(in oklab, ${accent} 10%, var(--panel)) 0%, var(--panel) 100%);`}
        >
          <div class="text-5xl mb-4" aria-hidden="true">{categoryData.icon}</div>
          <h2 class="font-display text-2xl text-ink mb-2">More on the way</h2>
          <p class="text-ink-dim text-sm">
            Articles for {categoryData.label} are in the pipeline.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
