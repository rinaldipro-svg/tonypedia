---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CategorySubnav from '../../components/CategorySubnav.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sortedArticles = allArticles.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout title="All Articles | Tonypedia" description="Every article on Tonypedia, sorted by publish date.">
  <CategorySubnav active="all" />

  <header class="mx-auto max-w-content px-6 pt-12 md:pt-16 pb-10">
    <div class="flex items-center gap-3 mb-4">
      <span class="label-mono">Archive</span>
      <span class="h-px w-12 block bg-line" aria-hidden="true"></span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <h1 class="md:col-span-8 display text-5xl md:text-6xl text-ink text-balance">
        All articles
      </h1>
      <p class="md:col-span-4 md:text-right text-ink-dim text-sm">
        {sortedArticles.length} article{sortedArticles.length !== 1 ? 's' : ''} ·
        across all categories
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-content px-6 pb-16">
    {
      sortedArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
          {sortedArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              pubDate={article.data.pubDate}
              slug={article.slug}
              heroImage={article.data.heroImage}
              readingTime={article.data.readingTime}
              body={article.body}
              tags={article.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="surface-panel p-12 text-center">
          <p class="text-ink-dim text-sm">No articles found yet.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
