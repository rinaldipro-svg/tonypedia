---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Intelligence Feed — Tonypedia"
  description="The Tonypedia Intelligence Feed: a curated live stream of GenAI and LLM developments. Launching in Phase 2."
>
  <section class="mx-auto max-w-content px-6 pt-16 md:pt-24 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-7">
        <div class="flex items-center gap-3 mb-6">
          <span class="label-mono text-sky">02 · Feed</span>
          <span class="h-px w-12 block bg-line" aria-hidden="true"></span>
        </div>
        <h1 class="display text-5xl md:text-7xl text-ink text-balance mb-6">
          Intelligence Feed <span class="italic-accent text-ink-dim">— coming in Phase 2.</span>
        </h1>
        <p class="text-lg text-ink-dim leading-relaxed max-w-xl mb-8">
          A live, curated stream of GenAI and LLM developments: foundations,
          tools, guides, prompts, industry shifts, and the data that matters.
          Cards expand inline; a ticker carries the current pulse across the top.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-line text-ink-dim hover:text-ink hover:border-line-2 transition-colors"
        >
          <span>← Back to the Hub</span>
        </a>
      </div>

      <aside class="md:col-span-5">
        <div
          class="surface-panel p-8 h-full"
          style="background:linear-gradient(180deg, color-mix(in oklab, var(--sky) 10%, var(--panel)) 0%, var(--panel) 100%);"
        >
          <span class="label-mono text-sky">What's coming</span>
          <ul class="mt-6 space-y-4 text-sm text-ink-dim leading-relaxed">
            <li class="flex gap-3">
              <span class="text-sky" aria-hidden="true">→</span>
              <span><strong class="text-ink">Six domains</strong> — Foundations, Tools, Guides, Prompts, Industry, Data.</span>
            </li>
            <li class="flex gap-3">
              <span class="text-sky" aria-hidden="true">→</span>
              <span><strong class="text-ink">Card → modal</strong> expand pattern, live search, and a ticker across the top.</span>
            </li>
            <li class="flex gap-3">
              <span class="text-sky" aria-hidden="true">→</span>
              <span><strong class="text-ink">Telegram screenshot intake</strong> via the existing agent spine (Phase 3).</span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
