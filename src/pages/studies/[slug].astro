---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  return studies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'studies'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} — Tonypedia`} description={entry.data.description}>
  <div class="study-bleed">
    <Content />
  </div>
</BaseLayout>

<style is:global>
  /* Detail page: cancel BaseLayout's main pt-24 so the iframe is truly full-bleed
     below the sticky nav (the nav floats over the iframe top edge) and reaches
     edge to edge horizontally. */
  body:has(.study-bleed) main {
    padding-top: 0;
  }
  .study-bleed {
    width: 100%;
  }
  .study-bleed .study-embed {
    display: block;
    margin: 0;
    border-radius: 0 !important;
    height: 100vh !important;
  }
  .study-bleed .study-embed iframe {
    display: block;
  }
</style>
