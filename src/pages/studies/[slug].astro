---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  return studies.map((entry) => ({
    params: { slug: entry.slug },
    props: { slug: entry.slug },
  }));
}

const { slug } = Astro.props;

// Map study slug → static HTML filename in public/studies/
const slugToHtml: Record<string, string> = {
  'coppernico-metals-investment-analysis': 'coppernico.html',
  'quantum-computing-2026-industrial-state': 'quantum.html',
  'global-dominance-30-technologies': 'Global_Dom.html',
  'rare-materials-financial-analysis': 'rare_materials.html',
  'robotics-matrix-top-50-2026': 'robotics_matrix.html',
  'uranium-nuclear-investment-study': 'uranium_nuclear.html',
};

const filename = slugToHtml[slug];
if (!filename) {
  throw new Error(`No static HTML mapping for study slug "${slug}"`);
}

return Astro.redirect(`/studies/${filename}`, 301);
---
