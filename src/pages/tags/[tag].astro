---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);

  const tags = new Set<string>();
  articles.forEach((article) => {
    article.data.tags.forEach((tag) => {
      tags.add(tag.toLowerCase().replace(/\s+/g, '-'));
    });
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const tagArticles = allArticles
  .filter((a) =>
    a.data.tags.some((t) => t.toLowerCase().replace(/\s+/g, '-') === tag)
  )
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const displayTag =
  tagArticles.length > 0
    ? tagArticles[0].data.tags.find(
        (t) => t.toLowerCase().replace(/\s+/g, '-') === tag
      )
    : tag;
---

<BaseLayout
  title={`#${displayTag} | Tonypedia`}
  description={`Articles tagged with ${displayTag} on Tonypedia.`}
>
  <header class="mx-auto max-w-content px-6 pt-12 md:pt-16 pb-10">
    <div class="flex items-center gap-3 mb-4">
      <span class="label-mono">Tag</span>
      <span class="h-px w-12 block bg-line" aria-hidden="true"></span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <h1 class="md:col-span-8 display text-5xl md:text-6xl text-ink text-balance">
        #<span class="italic-accent text-amber-soft">{displayTag}</span>
      </h1>
      <p class="md:col-span-4 md:text-right text-ink-dim text-sm">
        {tagArticles.length} article{tagArticles.length !== 1 ? 's' : ''}
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-content px-6 pb-16">
    {
      tagArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
          {tagArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              pubDate={article.data.pubDate}
              slug={article.slug}
              heroImage={article.data.heroImage}
              readingTime={article.data.readingTime}
              body={article.body}
              tags={article.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="surface-panel p-12 text-center">
          <h2 class="font-display text-2xl text-ink mb-2">Nothing here yet</h2>
          <p class="text-ink-dim text-sm">No articles are tagged with #{displayTag}.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
