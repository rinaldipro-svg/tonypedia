---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/helpers';
import Chip from '../components/Chip.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, type CategoryKey } from '../utils/categories';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { body } = article;
const {
  title,
  description,
  author,
  pubDate,
  category,
  tags,
  heroImage,
  readingTime: rt,
} = article.data;

const getReadingTime = (text: string) => {
  const wordsPerMinute = 200;
  const words = text.trim().split(/\s+/).length;
  return Math.ceil(words / wordsPerMinute);
};

const readingTime = rt || getReadingTime(body || '');
const meta = CATEGORIES[category as CategoryKey];
const accentVar = `var(--cat-${category})`;

const currentUrl = new URL(Astro.request.url).href;
const shareUrl = encodeURIComponent(currentUrl);
const shareTitle = encodeURIComponent(title);
---

<BaseLayout title={title} description={description} ogImage={heroImage || undefined} themeable>
  <ThemeToggle />
  <article class="mx-auto max-w-prose px-6 pt-8 pb-20">
    <!-- Eyebrow -->
    <div class="flex items-center gap-3 mb-6">
      <Chip category={category as CategoryKey} variant="category" size="sm" />
      <span class="label-mono">{meta.label}</span>
    </div>

    <!-- Title + deck -->
    <header class="mb-10">
      <h1 class="display text-4xl md:text-6xl text-ink text-balance mb-6">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-ink-dim leading-relaxed text-pretty">
        {description}
      </p>
    </header>

    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.7rem] font-mono uppercase tracking-[0.08em] text-ink-faint border-y border-line py-4 mb-10">
      <span>By {author}</span>
      <span aria-hidden="true">·</span>
      <span>{formatDate(pubDate)}</span>
      <span aria-hidden="true">·</span>
      <span>{readingTime} min read</span>

      <div class="ml-auto flex items-center gap-3">
        <a
          href={`https://x.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-faint hover:text-ink transition-colors"
          aria-label="Share on X"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M12.6 1H3.4C2.227 1 1 2.2 1 3.4v13.2C1 17.8 2.2 19 3.4 19h13.2c1.16 0 2.4-1.2 2.4-2.4V3.4C19 2.227 17.8 1 16.6 1zm-1.16 13.4h-2.52V7.2h2.52v7.2zM8.22 6.36c-.72 0-1.28-.65-1.28-1.38C6.94 4.3 7.5 3.6 8.22 3.6c.72 0 1.28.64 1.28 1.38 0 .73-.56 1.38-1.28 1.38zm9.82 7.04h-2.52v-3.9c0-.92-.4-1.55-1.2-1.55-.68 0-1.08.48-1.26.96-.08.16-.08.38-.08.6v3.89h-2.52V7.2h2.52v.96c.35-.52.96-1.28 2.37-1.28 1.72 0 3.01 1.13 3.01 3.58v3.9z"></path>
          </svg>
        </a>
        <button
          id="copy-link-btn"
          class="text-ink-faint hover:text-ink transition-colors"
          aria-label="Copy link"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.658 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Hero image -->
    {
      heroImage && (
        <figure class="-mx-6 md:mx-0 mb-12">
          <div class="overflow-hidden md:rounded-card border border-line">
            <img
              src={heroImage}
              alt={title}
              class="w-full h-auto max-h-[60vh] object-cover"
              loading="lazy"
            />
          </div>
        </figure>
      )
    }

    <!-- Body -->
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- Tags -->
    {
      tags.length > 0 && (
        <div class="mt-16 pt-8 border-t border-line">
          <span class="label-mono">Tags</span>
          <div class="flex flex-wrap gap-2 mt-3">
            {tags.map((tag) => (
              <Chip
                label={`#${tag}`}
                href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                size="sm"
              />
            ))}
          </div>
        </div>
      )
    }

    <!-- Related -->
    <div class="mt-16 pt-8 border-t border-line">
      <span class="label-mono">Related</span>
      <h2 class="font-display text-2xl text-ink mt-2 mb-6">More from {meta.label}</h2>
      <div id="related-articles-placeholder" style={`--card-accent:${accentVar};`}>
        <p class="text-ink-dim text-sm">Loading related articles…</p>
      </div>
    </div>
  </article>
</BaseLayout>

<script define:vars={{ currentUrl }}>
  async function copyLink() {
    try {
      await navigator.clipboard.writeText(currentUrl);
      const btn = document.getElementById('copy-link-btn');
      if (btn) {
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '✓';
        setTimeout(() => {
          btn.innerHTML = originalHTML;
        }, 2000);
      }
    } catch (err) {
      console.error('Failed to copy link:', err);
    }
  }

  document.getElementById('copy-link-btn')?.addEventListener('click', copyLink);
</script>
